{
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": ["assert", "error", "info", "warn"]
					}
				},
				"noGlobalIsFinite": "off"
			},
			"correctness": {
				"noUnusedVariables": "warn",
				"useHookAtTopLevel": "error",
				"useJsxKeyInIterable": "error",
				"noNestedComponentDefinitions": "error"
			},
			"style": { "noUnusedTemplateLiteral": "warn", "useImportType": "warn" }
		}
	},
	"formatter": {
		"enabled": true,
		"expand": "auto",
		"lineWidth": 120,
		"useEditorconfig": true
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "single",
			"semicolons": "always",
			"expand": "auto",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"attributePosition": "auto",
			"bracketSpacing": true
		}
	},
	"files": {
		"includes": ["**/*.js", "**/*.ts", "**/*.tsx", "**/*.mjs"]
	}
}
