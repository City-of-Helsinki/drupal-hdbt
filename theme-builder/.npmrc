engine-strict=true
min-release-age=1
# The npm scripts run inside a alpine container, see tools/sandbox.sh.
# Force npm to install Linux/musl binaries regardless of which operating
# system the developer uses.
os=linux
libc=musl
# Skip the vulnerability summary on install.
audit=false
# Fail npm audit only on critical vulnerabilities.
audit-level=critical
# Clean the funding message
fund=false
