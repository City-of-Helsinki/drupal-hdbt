engine-strict=true
min-release-age=1
# Copy the theme builder and install only its dependencies.
install-links=true
# The npm scripts run inside an alpine container, see the theme-builder sandbox command.
# Force npm to install Linux/musl binaries regardless of which operating
# system the developer uses.
os=linux
libc=musl
# Skip the vulnerability summary on install.
audit=false
# Fail npm audit only on critical vulnerabilities.
audit-level=critical
# Hide the funding message.
fund=false
