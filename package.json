{
  "name": "hdbt",
  "version": "1.1.0",
  "description": "Theme builder configuration for HDBT Drupal 10 theme",
  "author": "Druid",
  "license": "MIT",
  "repository": "github:City-of-Helsinki/drupal-hdbt",
  "scripts": {
    "dev": "node theme-builder.mjs --watch --dev",
    "build": "npm run format:js --loglevel=silent && npm run lint -s && npm run validate-ts && node theme-builder.mjs",
    "preinstall": "npx update-browserslist-db@latest",
    "lint:scss": "npx postcss \"src/scss/**/*.scss\" --syntax postcss-scss --use css-declaration-sorter --replace --no-map && npm run lint:stylelint",
    "lint:stylelint": "npx stylelint \"src/scss/**/*.scss\" --config ./theme-builder/.stylelintrc.yaml --formatter string --fix",
    "lint:js": "biome check --write --assist-enabled=true src/js/",
    "format:js": "biome format --write src/js/",
    "lint": "npm-run-all --parallel lint:scss lint:js -s",
    "full-reference": "./node_modules/.bin/dotenvx run -- node backstop/backstop_dynamic_config full reference",
    "full-test": "./node_modules/.bin/dotenvx run -- node backstop/backstop_dynamic_config full test",
    "full-approve": "./node_modules/.bin/dotenvx run -- node backstop/backstop_dynamic_config full approve",
    "fast-reference": "./node_modules/.bin/dotenvx run -- node backstop/backstop_dynamic_config fast reference",
    "fast-test": "./node_modules/.bin/dotenvx run -- node backstop/backstop_dynamic_config fast test",
    "fast-approve": "./node_modules/.bin/dotenvx run -- node backstop/backstop_dynamic_config fast approve",
    "validate-ts": "tsc --noEmit",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "@comment dependencies": [
    "The following packages were updated manually.",
    "Remove this section once the dependencies have been updated in their respective upstream packages.",
    {
      "ajv": ">=8.18.0, dependency of hds-react",
      "basic-ftp": ">=5.2.3, dependency of backstopjs",
      "tar-fs": ">=3.0.9, dependency of backstopjs",
      "diff": "^8.0.3, dependency of backstopjs",
      "minimatch": ">=10.2.1, dependency of hds-core (eslint)",
      "yauzl": "^3.2.1, dependency of backstopjs",
      "uuid": "^14.0.0, dependency of hds-react",
      "esbuild": "^0.28.1, dependency of vite (vitest); forces the test stack onto the same non-vulnerable esbuild theme-builder already uses (GHSA-gv7w-rqvm-qjhr, GHSA-g7r4-m6w7-qqqr)",
      "svg-sprite > glob": ">=13.0.0, drop vulnerable dependencies of svg-sprite dependency",
      "backstopjs > puppeteer": ">=25.0.8, Backstop depends on a vulnerable version of puppeteer",
      "postcss": ">=8.5.18, dependency of hds-react; fixes path traversal via sourceMappingURL (GHSA-r28c-9q8g-f849)",
      "@react-spring/* and react-popper": "$react, dependencies of hds-react; stale react ^18 peer ranges, verified React 19 safe. Remove once hds-react ships @react-spring/web >=10"
    }
  ],
  "overrides": {
    "basic-ftp": "^5.2.3",
    "diff": "^8.0.3",
    "ajv": "^8.18.0",
    "minimatch": "^10.2.1",
    "yauzl": "^3.2.1",
    "uuid": "^14.0.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.23",
    "svg-sprite": {
      "glob": "^13.0.0"
    },
    "backstopjs": {
      "puppeteer": "^25.8.0"
    },
    "@react-spring/web": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@react-spring/animated": {
      "react": "$react"
    },
    "@react-spring/core": {
      "react": "$react"
    },
    "@react-spring/shared": {
      "react": "$react"
    },
    "react-popper": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.15.0",
    "@elastic/elasticsearch": "^9.0.2",
    "@hdbt/theme-builder": "file:theme-builder",
    "@sentry/react": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "backstopjs": "^6.2.2",
    "chokidar": "^4.0.3",
    "classnames": "^2.3.1",
    "focus-trap": "^7.5.4",
    "glob": "^13.0.0",
    "hds-core": "6.0.5",
    "hds-design-tokens": "6.0.5",
    "hds-react": "6.0.5",
    "hyphenopoly": "^6.0.0",
    "jotai": "^2.6.0",
    "lodash-es": "^4.17.21",
    "mustache": "^4.2.0",
    "npm-run-all2": "^8.0.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "2.3.6",
    "tar-fs": ">=3.0.9",
    "typescript": "7.0.2"
  },
  "browserslist": [
    "last 3 major versions",
    "> 1%",
    "not dead"
  ],
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^3.0.8",
    "jsdom": "^26.0.0",
    "vitest": "^3.0.8"
  }
}
