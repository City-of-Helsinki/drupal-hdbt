{% embed '@hdbt/component/content-list-with-count.twig' with { show_count_container: true }%}
  {% block count_container%}
    {% if total_rows %}
      {{ total_rows }} {% trans with {'context': 'Service list search count'}%}advisory service{% plural total_rows %}advisory services{% endtrans %}
    {% else %}
      {{ 'No results'|t({}, {'context' : 'Content list with count no results title'}) }}
    {% endif %}
  {% endblock count_container %}
{% endembed %}
