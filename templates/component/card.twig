{#
{% embed '@hdbt/component/card.twig' with {
    card_wrapper_element: 'li',
    card_modifier_class: 'card--cardtype',
    card_image: card_image,
    card_title_level: 'h3',
    card_title_lang: 'fi',
    card_title: 'Otsikko',
    card_url: 'https://www.hel.fi/fi/',
    card_url_external: false,
    card_category_tag: {
      tag: 'Kategoria',
      color: 'gold',
    },
    card_description: 'Lyhyt kuvaus',
    card_description_html: false,
    card_helptext: 'Ohjeteksti',
    card_helptext_html: false,
    card_actions: [
      {
        label: 'Lue lisää',
        url: 'https://www.hel.fi/fi/',
        icon: 'trash'
        class: 'class'
      },
    ],
    card_metas: [
      {
        icon: 'clock',
        label: 'Aika',
        content: 'Lorem'
      },
      {
        icon: 'calendar',
        label: 'Ajanjakso',
        content: 'Ipsum'
      },
    ],
    card_tags: [
      {
        tag:'test',
        color: 'gold',
      },
      {
        tag: 'test2',
      }
    ],
  } %}
{% endembed %}

card_actions renders secondary buttons at the bottom of the card. Each action
takes a label and url, and optionally an icon name (e.g. 'trash').
The whole block can also be overridden with {% block card_actions %}.
#}

{{ attach_library('hdbt/card-helper') }}

{% set card_external_class = card_url_external ? 'card--external' : '' %}

<{{ card_wrapper_element|default('div') }} class="card{% if card_modifier_class %} {{ card_modifier_class }}{% endif %}{% if card_external_class %} {{ card_external_class }}{% endif %}">
  {% if card_image %}
    <div class="card__image">
      {{ card_image }}
    </div>
  {% endif %}

  <div class="card__text">
    <{{ card_title_level|default('h4') }} class="card__title" {% if card_title_lang %}lang="{{ card_title_lang }}"{% endif %}>
      {% if card_url %}
        {{ link(card_title, card_url, { 'class':['card__link'], 'rel':'bookmark' }) }}
      {% else %}
        {{ card_title }}
      {% endif %}
    </{{ card_title_level|default('h4') }}>

    {% if card_category_tag %}
      <div class="card__category">
        {% embed '@hdbt/misc/tag-list.twig' with {
          tag_container_class: 'content-tags--card'
        }%}
          {% block content %}
            {% include '@hdbt/misc/tag.twig' with {
              tag: card_category_tag.tag,
              color: card_category_tag.color,
              addSpan: true,
            }%}
          {% endblock content %}
        {% endembed %}
      </div>
    {% endif %}

    {% if card_description %}
      <div class="card__description">
        {% if card_description_html %}
          {{ card_description }}
        {% else %}
          <p>{{ card_description }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if card_helptext %}
      <div class="card__helptext">
        {% if card_helptext_html %}
          {{ card_helptext }}
        {% else %}
          <p>{{ card_helptext }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if card_metas %}
      <div class="card__metas">
        {% for card_meta in card_metas %}
            <div class="card__meta">{% if card_meta.icon %}<span class="card__meta__icon">{% include '@hdbt/misc/icon.twig' ignore missing with {icon: card_meta.icon} only %}</span>{% endif %}{% if card_meta.label %}<span class="card__meta__label">{{ card_meta.label }}: </span>{% endif %}<span class="card__meta__content">{{ card_meta.content }}</span>
            </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if card_tags %}
      <div class="card__tags">
        {% embed '@hdbt/misc/tag-list.twig' with { tags: card_tags, addSpan: true, tag_container_class: 'content-tags--card' } %}
        {% endembed %}
      </div>
    {% endif %}

    {% set card_actions_output %}
      {% block card_actions %}
        {% for card_action in card_actions %}
          <a class="hds-button hds-button--secondary {{card_action.class}}" href="{{ card_action.url }}">
            {% if card_action.icon %}
              {% include '@hdbt/misc/icon.twig' ignore missing with {icon: card_action.icon} only %}
            {% endif %}
            <span class="hds-button__label"{% if card_action.aria_label %}aria-hidden="true"{% endif %}>{{ card_action.label }}</span>
            {% if card_action.aria_label %}
              <span class="visually-hidden">{{ card_action.aria_label }}</span>
            {% endif %}
          </a>
        {% endfor %}
      {% endblock card_actions %}
    {% endset %}

    {% if card_actions_output|trim is not empty %}
      <div class="card__actions">
        {{ card_actions_output }}
      </div>
    {% endif %}
  </div>
</{{ card_wrapper_element|default('div') }}>
