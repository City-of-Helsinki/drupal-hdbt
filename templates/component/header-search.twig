{% set dropdown_id = 'search-dropdown' %}

{% embed "@hdbt/navigation/nav-toggle-button.twig" with {
  modifier_class: 'nav-toggle--search',
  controls: dropdown_id,
  js_target: 'js-search-button',
  open_label: 'Search'|t({}, {'context': 'Helfi menu search button'}),
} %}
{% endembed %}

{% set modifier_class = 'nav-toggle-dropdown--search js-search-dropdown' ~ (user_not_logged_in ? '' : ' nav-toggle-dropdown--search--ai') %}

{% embed "@hdbt/navigation/nav-toggle-dropdown.twig" with {
  id: dropdown_id,
  modifier_class: modifier_class,
} %}
  {% block content%}
    <div class="header-search-wrapper{% if not user_not_logged_in %} header-search-wrapper--ai{% endif %}">
      {% if user_not_logged_in %}
        <div class="header-search__title">{{'Search in City of Helsinki websites'|t({}, {'context': 'Header search title'})}}</div>
        {% include "@hdbt/component/helfi-search-form.twig" with {
          label: 'What are you looking for?'|t({}, {'context': 'Header and hero search label'}),
          search_id: 'header'
        } %}
      {% else %}
        <div class="header-search__title">{{'Search this site'|t({}, {'context': 'Site search'})}}</div>
        {% include "@hdbt/component/helfi-search-form.twig" with {
          label: 'Search term or question'|t({}, {'context': 'Site search'}),
          help_text: 'The search uses artificial intelligence.'|t({}, {'context': 'Site search'}),
          help_text_link_url: help_text_link_url,
          help_text_link_text: 'Read about the use of AI in search.'|t({}, {'context': 'Site search'}),
          search_id: 'header',
        } %}
      {% endif %}
      
      <noscript class="header-search__javascript-disabled">
        {% set search_link_text %}
          {{ "Hel.fi search"|t({}, {'context': 'Header search, no javascript link'}) }}
        {% endset %}
        <p>
          {{ link(search_link_text, helfi_search_form_url) }}
          {{ "requires JavaScript. Your browser doesn't support JavaScript or it is disabled. Please check your browser settings and try again."|t({}, {'context': 'Header search, no javascript'}) }}
        </p>
      </noscript>

      {% if user_not_logged_in %}
        <div class="search-container__links-container">
          <div class="search-container__link">
            {% set link_title_events %}
            {{ 'Search for events'|t({}, {'context': 'Header search, search for events'}) }}
            {% endset %}
            {% set link_attributes = {
              'class': [
                'search__link-external',
              ],
            } %}
            {{ link(link_title_events, events_link_url, link_attributes) }}
            <p>{{'Find upcoming events at the Events.hel.fi website.'|t}}</p>
          </div>
          <div class="search-container__link">
            {% set link_title_decisions %}
            {{ 'Search for decisions'|t({}, {'context': 'Header search, search for decisions'}) }}
            {% endset %}
            {{ link(link_title_decisions, decisions_link_url, link_attributes) }}
            <p>{{'Find municipal decisions in the Decision-making section.'|t}}</p>
          </div>
        </div>
      {% else %}
        {% set announcement_title = 'Looking for these search services?'|t({}, {'context': 'Site search'}) %}
        {% set announcement_labelled_by = "announcement__title--" ~ random() %}
        {% set announcement_type_labelled_by = "announcement__type--" ~ random() %}
        <section aria-labelledby="{{ announcement_labelled_by }} {{ announcement_type_labelled_by }}" class="announcement hds-notification notification--site-search">
          <div class="announcement__container">
            <div class="announcement__title">
              <span id="{{ announcement_labelled_by }}">{{ announcement_title }}</span>
            </div>
            <div class="announcement__content">
              {% set jobs_title = "Open jobs"|t({}, {'context': 'Site search'}) %}
              {% set events_title = "Events"|t({}, {'context': 'Site search'}) %}
              {% set decisions_title = "Decisions"|t({}, {'context': 'Site search'}) %}
              {% set contact_title = "Contact information"|t({}, {'context': 'Site search'}) %}
              {% set helsinki_near_you_title = "Helsinki near you"|t({}, {'context': 'Site search'}) %}
              <ul>
                {% if jobs_link_url %}<li>{{ link(jobs_title, jobs_link_url) }}</li>{% endif %}
                {% if events_link_url %}<li>{{ link(events_title, events_link_url) }}</li>{% endif %}
                {% if decisions_link_url %}<li>{{ link(decisions_title, decisions_link_url) }}</li>{% endif %}
                {% if contact_link_url %}<li>{{ link(contact_title, contact_link_url) }}</li>{% endif %}
                {% if helsinki_near_you_link_url %}<li>{{ link(helsinki_near_you_title, helsinki_near_you_link_url) }}</li>{% endif %}
              </ul>
            </div>
          </div>
        </section>
      {% endif %}
    </div>
  {% endblock %}
{% endembed %}

